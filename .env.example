# ============================================================
# AutoML Environment Variables
# ============================================================
# Copy this file to .env and fill in the values before running
# the application.  Never commit .env to version control.

# ----------------------------------------------------------
# LLM providers
# Only the key for the selected LLM_PROVIDER is required.
# ----------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Which LLM provider to use: 'google' (default) or 'groq'
# If set to 'google', only GOOGLE_API_KEY is required.
# If set to 'groq', only GROQ_API_KEY is required.
LLM_PROVIDER=google

# ----------------------------------------------------------
# Storage paths (optional – defaults shown)
# ----------------------------------------------------------
DATA_STORAGE_PATH=./data/datasetAnalysis
LOGS_PATH=./logs

# ----------------------------------------------------------
# Authentication
# ----------------------------------------------------------
# Set a strong random secret to protect the public API and
# the MCP plugin endpoints.  When this variable is empty or
# absent, authentication is disabled (suitable for local
# development only).
#
# Generate a key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
AUTOML_API_KEY=

# ----------------------------------------------------------
# MCP server (used by mcp_server.py)
# ----------------------------------------------------------
# Base URL of the running AutoML FastAPI backend that the MCP
# server should forward tool calls to.
AUTOML_API_URL=http://127.0.0.1:8000

# Restrict which directory the MCP server is allowed to read
# files from when Claude calls upload_dataset.  Defaults to
# the home directory (~) when not set.
AUTOML_UPLOAD_DIR=
